# Vite fingerprints everything under /assets, so those files can be cached
# forever. The engraver bundle alone is ~8 MB, which makes the difference
# between a slow first visit and an instant second one.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The entry point must always be revalidated, or a new build is never picked up.
/index.html
  Cache-Control: public, max-age=0, must-revalidate
